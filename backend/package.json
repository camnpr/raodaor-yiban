{
  "name": "@raodaor/yiban-backend",
  "version": "0.1.0",
  "author": "camnpr<camnpr@163.com>",
  "private": true,
  "description": "绕道儿颐伴后端（NestJS，端口 9015）",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "node scripts/prisma-with-env.js generate",
    "prisma:migrate": "node scripts/prisma-with-env.js migrate dev",
    "prisma:migrate:prod": "node scripts/prisma-with-env.js --prod migrate deploy",
    "prisma:studio": "node scripts/prisma-with-env.js studio",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 restart ecosystem.config.js --env development --update-env",
    "pm2:restart:prod": "pm2 restart ecosystem.config.js --env production --update-env",
    "pm2:reload": "pm2 reload ecosystem.config.js --env development --update-env",
    "pm2:reload:prod": "pm2 reload ecosystem.config.js --env production --update-env",
    "pm2:stop": "pm2 stop raodaor-yiban-server",
    "pm2:delete": "pm2 delete raodaor-yiban-server",
    "pm2:logs": "pm2 logs raodaor-yiban-server --lines 100",
    "pm2:status": "pm2 status raodaor-yiban-server"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
