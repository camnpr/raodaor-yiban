# ===== 绕道儿颐伴 后端环境变量模板（复制为 .env.development / .env.production 后填写） =====

# 服务
PORT=9015
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/raodaor_yiban?schema=public
CORS_ALLOW_ORIGINS=http://localhost:5115

# 本平台 JWT（access 15 分钟 + refresh 7 天，旋转签发）
JWT_ACCESS_SECRET=<本平台 JWT 密钥>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# IDStack（仅服务端；api_key/secret_key 换 token 用，JWKS 公钥验签无需共享密钥）
IDSTACK_BASE_URL=https://idstack.raodaor.com
IDSTACK_API_BASE_URL=https://idstack.raodaor.com
IDSTACK_APP_ID=<应用 UUID>
IDSTACK_APP_API_KEY=<client_id>
IDSTACK_APP_SECRET_KEY=<client_secret>
# IDSTACK_JWKS_URI=       # 可选，缺省由 IDSTACK_API_BASE_URL 推导
# IDSTACK_ISSUER=         # 可选，缺省 https://idstack.raodaor.com

# RaoDaor Message（天气预警/简报站内通知投递）
RAODAOR_MESSAGE_BASE_URL=https://message.raodaor.com
RAODAOR_MESSAGE_INBOUND_KEY=rdae_<入站密钥>

# RaoDaor File（模式 B 应用租户，头像/截图/反馈图片）
RAODAOR_FILE_BASE_URL=https://file.raodaor.com
RAODAOR_FILE_API_KEY=rdfl_<应用租户 ApiKey>

# RaoDaor Docs（导入导出 Open API）
RAODAOR_DOCS_BASE_URL=https://docs.raodaor.com
RAODAOR_DOCS_ORG_KEY=rdorg_<组织 Key>
