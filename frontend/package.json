{
  "name": "@raodaor/yiban-frontend",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "author": "camnpr<camnpr@163.com>",
  "private": true,
  "scripts": {
    "start": "expo start -c --port 5117",
    "dev": "expo start -c --port 5117",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 5117",
    "build": "npx expo export --platform web",
    "build:android": "npx eas build -p android --profile apkInstall --clear-cache",
    "build:ios": "npx eas build -p ios --profile production --clear-cache",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.19",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-qr-code": "^2.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "~5.9.3"
  }
}
