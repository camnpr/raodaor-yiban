# TypeScript 规则

## 必须遵守

```typescript
// 1. 明确的接口定义
interface ButtonProps {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  children: React.ReactNode;
  onClick?: () => void;
}

// 2. 函数返回值类型
function add(a: number, b: number): number {
  return a + b;
}

// 3. 泛型约束
interface ApiResponse<T> {
  success: boolean;
  data?: T;
  error?: string;
}

// 4. 空值安全
const name = user?.profile?.name ?? 'Anonymous';
```

## 禁止行为

```typescript
// 1. 禁止 any 类型
function process(data: any) {} // ❌

// 2. 禁止隐式返回
const getData = () => fetch('/api/data'); // ❌ 缺少返回类型

// 3. 谨慎使用非空断言
const element = document.getElementById('app')!; // ⚠️ 谨慎使用
```

